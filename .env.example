# 云端服务监听端口（Nginx 对外转发到此端口）
PRINT_PORT=8011
PRINT_SECRET=replace-with-a-long-random-secret
PRINT_INVITE_CODE=replace-with-your-invite-code
PRINT_RETENTION_DAYS=30

# PostgreSQL：只在云服务器使用，绝不放进 EXE 或 GitHub。
PRINT_CLOUD_DB_URL=postgresql://printer:replace-password@127.0.0.1:5432/printer

# Cloudflare R2 私有桶：只在云服务器使用。
PRINT_STORAGE_BACKEND=r2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=print-files
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret

# 服务器上的临时目录。R2 文件不在这里长期保存。
PRINT_DATA_DIR=/opt/print-cluster/data
