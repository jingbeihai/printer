# 云端服务监听端口（Nginx 对外转发到此端口）
PRINT_PORT=8011
PRINT_SECRET=replace-with-a-long-random-secret
PRINT_INVITE_CODE=101010
PRINT_BOOTSTRAP_ADMIN_USERNAME=admin
PRINT_BOOTSTRAP_ADMIN_PASSWORD=262626
# 打印站专用设备令牌：执行 `openssl rand -base64 32` 生成。
PRINT_AGENT_TOKEN=replace-with-a-long-random-agent-token
PRINT_RETENTION_DAYS=30

# PostgreSQL：只在云服务器使用，绝不放进 EXE 或 GitHub。
PRINT_CLOUD_DB_URL=postgresql://printer:replace-password@127.0.0.1:5432/printer

# 文件存储。local 保存到服务器磁盘；cos 由客户端使用短期签名地址直传。
PRINT_STORAGE_BACKEND=cos
PRINT_DATA_DIR=/opt/print-cluster/data
COS_REGION=ap-shanghai
COS_BUCKET=printer-1334043867
COS_SECRET_ID=replace-with-cam-secret-id
COS_SECRET_KEY=replace-with-cam-secret-key
COS_PRESIGN_SECONDS=600
